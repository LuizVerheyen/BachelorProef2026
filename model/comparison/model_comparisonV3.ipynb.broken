   "source": [
    "## 17. Vergelijking binary vs 3-class"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 22,
   "id": "65edd10e",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "=== BINARY ===\n",
      "              model  train_acc  val_acc  val_f1  test_acc  precision  recall     f1  roc_auc    mae       mape  brier\n",
      "                GRU     0.5021   0.5315  0.5720    0.5250     0.5214  0.7867 0.6271   0.5227 0.4909 29478.0254 0.2804\n",
      "           LightGBM     0.7007   0.5141  0.5881    0.5203     0.5385  0.4031 0.4611   0.5340 0.4950 22458.3162 0.2571\n",
      "            XGBoost     0.6670   0.5204  0.6012    0.5191     0.5211  0.6840 0.5915   0.5248 0.4961 25137.9840 0.2533\n",
      "               LSTM     0.4989   0.5354  0.5411    0.5158     0.5243  0.4989 0.5113   0.5214 0.4938 24433.2913 0.2760\n",
      "      Random Forest     0.6600   0.5031  0.5175    0.5130     0.5406  0.2880 0.3758   0.5303 0.4988 24070.7603 0.2492\n",
