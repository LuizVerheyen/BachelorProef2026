    "results_3_df  .to_csv(ARTIFACTS / \"results_3.csv\",   index=False)\n",
    "print(\"=== BINARY ===\"); print(results_bin_df.round(4).to_string(index=False))\n",
    "print(\"\\n=== 3-CLASS ===\"); print(results_3_df.round(4).to_string(index=False))"
