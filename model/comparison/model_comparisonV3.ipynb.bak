    "## 17. Vergelijking binary vs 3-class"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 22,
   "id": "65edd10e",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "=== BINARY ===\n",
      "              model  train_acc  val_acc  val_f1  test_acc  precision  recall     f1  roc_auc    mae       mape  brier\n",
      "           LightGBM     0.7009   0.5134  0.5807    0.5273     0.5313  0.6667 0.5914   0.5383 0.4921 25441.7721 0.2515\n",
      "            XGBoost     0.6685   0.5123  0.5832    0.5214     0.5388  0.4660 0.4998   0.5289 0.4954 23311.6487 0.2526\n",
      "                GRU     0.5012   0.5198  0.5473    0.5167     0.5193  0.7119 0.6005   0.5211 0.4909 28143.0318 0.2793\n",
      "     Majority class     0.5177   0.5278  0.6910    0.5130     0.5130  1.0000 0.6781   0.5000 0.4870 48703.1042 0.4870\n",
      "                MLP     0.6728   0.5182  0.5782    0.5129     0.5183  0.7144 0.6007   0.5157 0.4886 29783.5194 0.3230\n",
